# ====================================================================
# CAMPUS LOST & FOUND MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your real credentials.
# ====================================================================

# Google Cloud OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/LostFoundManagementSystem/api/auth/google/callback

# Gmail SMTP Configuration for Real Email OTP Dispatch
# Use a 16-digit Google App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=replace_with_google_app_password

# Authentication Policies
ALLOWED_EMAIL_DOMAIN=gmail.com
OTP_EXPIRY_MINUTES=5
SESSION_TIMEOUT_MINUTES=30
JWT_SECRET=replace_with_a_long_random_secret

# PostgreSQL database configuration
# On Render, set DATABASE_URL to the Render PostgreSQL internal connection URL.
# The URL may use postgres:// or postgresql://; SSL is enabled automatically.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
#
# Alternatively, configure the connection with individual variables:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lost_found_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSLMODE=prefer
#
# Or supply a JDBC URL plus credentials:
# DB_URL=jdbc:postgresql://localhost:5432/lost_found_db
# DB_USERNAME=your_database_user

# Port / URLs
APP_URL=http://localhost:8080/LostFoundManagementSystem
UPLOAD_DIR=uploads/items
