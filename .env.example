# ====================================================================
# CAMPUS LOST & FOUND MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your real credentials.
# ====================================================================

# --------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL by default; MySQL is also supported)
# --------------------------------------------------------------------

# Option A: PostgreSQL (local development)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lost_found_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Option B: MySQL (for existing MySQL deployments)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=lost_found_db
# DB_USER=root
# DB_PASSWORD=
# DB_SSL=false

# Option C: Cloud Database Connection String (e.g., Aiven, Render, Railway, Supabase)
# For MySQL:
# DATABASE_URL=mysql://user:password@host:3306/lost_found_db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/lost_found_db

# Option D: Complete PostgreSQL JDBC URL
# DB_URL=jdbc:postgresql://localhost:5432/lost_found_db?sslmode=prefer

# --------------------------------------------------------------------
# 2. SERVER & APPLICATION URLS
# --------------------------------------------------------------------
PORT=8080
APP_URL=http://localhost:8080/LostFoundManagementSystem
UPLOAD_DIR=uploads/items

# --------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY POLICIES
# --------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=gmail.com
OTP_EXPIRY_MINUTES=5
SESSION_TIMEOUT_MINUTES=30
JWT_SECRET=replace_with_a_long_random_secret_32_characters_or_more

# --------------------------------------------------------------------
# 4. OPTIONAL: GOOGLE OAUTH 2.0 (https://console.cloud.google.com)
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/LostFoundManagementSystem/api/auth/google/callback

# --------------------------------------------------------------------
# 5. OPTIONAL: GMAIL SMTP FOR EMAIL OTP
# --------------------------------------------------------------------
# Use a 16-digit Google App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=replace_with_google_app_password
